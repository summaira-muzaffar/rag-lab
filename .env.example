# Copy to .env and fill in
ANTHROPIC_API_KEY=your-key-here
LLM_BACKEND=anthropic        # anthropic | echo (echo = no LLM, shows retrieved text)
LLM_MODEL=claude-sonnet-5-5
EMBED_BACKEND=local          # local (sentence-transformers) | hash (offline test mode)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
