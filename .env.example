# Copy to .env and fill in
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_BACKEND=gemini           # gemini | echo (echo = no LLM, shows retrieved text)
EMBED_BACKEND=local          # local (sentence-transformers) | hash (offline test mode)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4